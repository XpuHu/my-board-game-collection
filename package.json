{
  "name": "boardgamecollection",
  "version": "1.0.0",
  "description": "Personal board game collection manager built around Item entities.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:vercel": "npm run build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:tools": "node --test scripts/lib/*.test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:deploy": "node scripts/database.mjs deploy",
    "db:seed": "node scripts/database.mjs seed",
    "db:studio": "node scripts/database.mjs studio",
    "db:snapshot": "node scripts/data.mjs snapshot",
    "db:transfer": "node scripts/data.mjs transfer",
    "db:verify": "node scripts/data.mjs verify",
    "db:backup": "node scripts/data.mjs backup",
    "db:local": "node scripts/local-postgres.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.16",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "17.4.2",
    "lucide-react": "^1.23.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.1",
    "@electric-sql/pglite-socket": "0.1.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.9.4",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
