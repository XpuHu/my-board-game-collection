DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"
# npm test uses temporary local PostgreSQL by default. Set ALL three only for a dedicated external test database.
# TEST_DATABASE_URL=
# TEST_DATABASE_URL_UNPOOLED=
# TEST_DATABASE_EXPECTED_ID="TEST_ENDPOINT-pooler.REGION.aws.neon.tech:5432/neondb"
# Optional: base64-encoded 32-byte key for encrypted full backups; keep a recovery copy separately.
# BACKUP_ENCRYPTION_KEY=
APP_URL="http://localhost:3000"
EXTERNAL_PROVIDERS_ENABLED=false
BGG_SYNC_ENABLED=false
BGG_TOKEN=

# mvp: collection, item card and preorders; full restores deferred UI.
APP_PRODUCT_MODE=mvp
