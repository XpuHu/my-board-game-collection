generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model ItemType {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items Item[]

  @@map("item_types")
}

model Item {
  id            String    @id @default(uuid())
  typeId        String    @map("type_id")
  title         String
  originalTitle String?   @map("original_title")
  description   String?
  year          Int?
  minPlayers    Int?      @map("min_players")
  maxPlayers    Int?      @map("max_players")
  minPlayTime   Int?      @map("min_play_time")
  maxPlayTime   Int?      @map("max_play_time")
  minAge        Int?      @map("min_age")
  complexity    Decimal?
  rating        Decimal?
  sourceMode    String    @default("manual") @map("source_mode")
  categories    Json?
  mechanics     Json?
  designers     Json?
  artists       Json?
  publishers    Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  type               ItemType            @relation(fields: [typeId], references: [id], onDelete: Restrict)
  userItem           UserItem?
  externalReferences ExternalReference[]
  playSessions       PlaySession[]
  purchases          Purchase[]
  preorders          Preorder[]
  images             Image[]
  notes              Note[]
  links              Link[]
  tags               Tag[]               @relation("ItemTags")
  parentRelations    ItemRelation[]      @relation("ParentItemRelations")
  childRelations     ItemRelation[]      @relation("ChildItemRelations")
  itemMechanics      ItemMechanic[]
  itemCategories     ItemCategory[]
  itemDesigners      ItemDesigner[]
  itemArtists        ItemArtist[]
  itemPublishers     ItemPublisher[]

  @@index([title])
  @@index([originalTitle])
  @@index([typeId])
  @@map("items")
}

model UserItem {
  id             String    @id @default(uuid())
  itemId         String    @unique @map("item_id")
  owned          Boolean   @default(false)
  wishlist       Boolean   @default(false)
  status         String    @default("wishlist")
  ownedAt        DateTime? @map("owned_at")
  favorite       Boolean   @default(false)
  location       String?
  personalRating Int?      @map("personal_rating")
  notes          String?
  interestLevel  Int?      @map("interest_level")
  decisionNotes  String?   @map("decision_notes")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([owned])
  @@index([wishlist])
  @@index([status])
  @@index([favorite])
  @@index([owned, ownedAt])
  @@map("user_items")
}

model ExternalReference {
  id         String    @id @default(uuid())
  itemId     String    @map("item_id")
  provider   String
  externalId String    @map("external_id")
  url        String?
  lastSync   DateTime? @map("last_sync")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([itemId])
  @@index([provider])
  @@map("external_references")
}

model PlaySession {
  id                String    @id @default(uuid())
  itemId            String    @map("item_id")
  playedAt          DateTime  @map("played_at")
  startedAt         DateTime? @map("started_at")
  playersCount      Int?      @map("players_count")
  durationMinutes   Int?      @map("duration_minutes")
  result            String?
  score             String?
  scenario          String?
  playerNames       Json?     @map("player_names")
  usedItemIds       Json?     @map("used_item_ids")
  notes             String?
  source            String    @default("manual")
  bggPlayId         String?   @unique @map("bgg_play_id")
  locallyModifiedAt DateTime? @map("locally_modified_at")
  importedAt        DateTime? @map("imported_at")
  personalRating    Int?      @map("personal_rating")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([playedAt])
  @@index([bggPlayId])
  @@map("play_sessions")
}

model Mechanic {
  id             String         @id @default(uuid())
  name           String
  normalizedName String         @unique @map("normalized_name")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")
  items          ItemMechanic[]

  @@map("mechanics")
}

model ItemMechanic {
  itemId     String   @map("item_id")
  mechanicId String   @map("mechanic_id")
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  mechanic   Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Restrict)

  @@id([itemId, mechanicId])
  @@index([mechanicId])
  @@map("item_mechanics")
}

model Category {
  id             String         @id @default(uuid())
  name           String
  normalizedName String         @unique @map("normalized_name")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")
  items          ItemCategory[]

  @@map("categories")
}

model ItemCategory {
  itemId     String   @map("item_id")
  categoryId String   @map("category_id")
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([itemId, categoryId])
  @@index([categoryId])
  @@map("item_categories")
}

model Designer {
  id             String         @id @default(uuid())
  name           String
  normalizedName String         @unique @map("normalized_name")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")
  items          ItemDesigner[]

  @@map("designers")
}

model ItemDesigner {
  itemId     String   @map("item_id")
  designerId String   @map("designer_id")
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  designer   Designer @relation(fields: [designerId], references: [id], onDelete: Restrict)

  @@id([itemId, designerId])
  @@index([designerId])
  @@map("item_designers")
}

model Artist {
  id             String       @id @default(uuid())
  name           String
  normalizedName String       @unique @map("normalized_name")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")
  items          ItemArtist[]

  @@map("artists")
}

model ItemArtist {
  itemId   String @map("item_id")
  artistId String @map("artist_id")
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Restrict)

  @@id([itemId, artistId])
  @@index([artistId])
  @@map("item_artists")
}

model Publisher {
  id             String          @id @default(uuid())
  name           String
  normalizedName String          @unique @map("normalized_name")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")
  items          ItemPublisher[]

  @@map("publishers")
}

model ItemPublisher {
  itemId      String    @map("item_id")
  publisherId String    @map("publisher_id")
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Restrict)

  @@id([itemId, publisherId])
  @@index([publisherId])
  @@map("item_publishers")
}

model Purchase {
  id           String    @id @default(uuid())
  itemId       String    @map("item_id")
  shop         String
  price        Decimal
  currency     String
  deliveryCost Decimal?  @map("delivery_cost")
  discount     Decimal?
  totalPrice   Decimal   @map("total_price")
  purchaseDate DateTime? @map("purchase_date")
  comment      String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("purchases")
}

model Preorder {
  id                    String    @id @default(uuid())
  itemId                String    @map("item_id")
  parentId              String?   @map("parent_id")
  pricingMode           String    @default("per_item") @map("pricing_mode")
  paymentType           String    @default("unspecified") @map("payment_type")
  priceKnown            Boolean   @default(true) @map("price_known")
  parent                Preorder? @relation("PreorderLot", fields: [parentId], references: [id], onDelete: Cascade)
  children              Preorder[] @relation("PreorderLot")
  shop                  String
  price                 Decimal
  currency              String
  orderDate             DateTime? @map("order_date")
  expectedDate          DateTime? @map("expected_date")
  expectedDatePrecision String    @default("day") @map("expected_date_precision")
  receivedDate          DateTime? @map("received_date")
  fullyPaid             Boolean?  @map("fully_paid")
  paymentSchedule       Json?     @map("payment_schedule")
  paymentVersion        Int       @default(0) @map("payment_version")
  orderUrl              String?   @map("order_url")
  deliveryMethod        String    @default("unspecified") @map("delivery_method")
  deliveryCost          Decimal?  @map("delivery_cost")
  trackingNumber        String?   @map("tracking_number")
  status                String
  comment               String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  item   Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  events PreorderEvent[]

  @@index([itemId])
  @@index([status])
  @@index([expectedDate])
  @@index([parentId])
  @@map("preorders")
}

model PreorderEvent {
  id         String   @id @default(uuid())
  preorderId String   @map("preorder_id")
  type       String
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  reason     String?
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  preorder Preorder @relation(fields: [preorderId], references: [id], onDelete: Cascade)

  @@index([preorderId])
  @@map("preorder_events")
}

model Image {
  id        String   @id @default(uuid())
  itemId    String   @map("item_id")
  type      String
  provider  String?
  url       String?
  path      String?
  caption   String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("images")
}

model Note {
  id        String   @id @default(uuid())
  itemId    String   @map("item_id")
  title     String?
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("notes")
}

model ItemRelation {
  id           String   @id @default(uuid())
  parentItemId String   @map("parent_item_id")
  childItemId  String   @map("child_item_id")
  relationType String   @map("relation_type")
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  parentItem Item @relation("ParentItemRelations", fields: [parentItemId], references: [id], onDelete: Cascade)
  childItem  Item @relation("ChildItemRelations", fields: [childItemId], references: [id], onDelete: Cascade)

  @@unique([parentItemId, childItemId, relationType])
  @@index([parentItemId])
  @@index([childItemId])
  @@map("item_relations")
}

model Link {
  id        String   @id @default(uuid())
  itemId    String   @map("item_id")
  type      String
  url       String
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("links")
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items Item[] @relation("ItemTags")

  @@map("tags")
}

model CommandReceipt {
  id String @id
  kind String
  fingerprint String
  result String
  createdAt DateTime @default(now()) @map("created_at")
  @@map("command_receipts")
}
